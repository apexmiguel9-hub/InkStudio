+#if defined(__ANDROID__)
+// FASE8: unwinding portable — backtrace() solo existe desde Android API 30
+// (minSdk=29), _Unwind_Backtrace existe en todas las APIs del NDK.
+struct Fase8UnwindCtx
+{
+    void **frames;
+    int count;
+    int max;
+};
+
+static _Unwind_Reason_Code
+fase8_unwind_cb (struct _Unwind_Context *ctx, void *arg)
+{
+    Fase8UnwindCtx *c = static_cast<Fase8UnwindCtx *>(arg);
+    if (c->count >= c->max) {
+        return _URC_END_OF_STACK;
+    }
+    c->frames[c->count++] = reinterpret_cast<void *>(_Unwind_GetIP(ctx));
+    return _URC_NO_REASON;
+}
+
+static void
+fase8_dump_backtrace (int fd)
+{
+    void *frames[128];
+    Fase8UnwindCtx ctx = {frames, 0, 128};
+    _Unwind_Backtrace(fase8_unwind_cb, &ctx);
+    char line[256];
+    for (int i = 0; i < ctx.count; i++) {
+        Dl_info info;
+        void *base = frames[i];
+        const char *sym = "?";
+        const char *file = "?";
+        if (dladdr(frames[i], &info)) {
+            if (info.dli_sname) {
+                sym = info.dli_sname;
+                base = info.dli_saddr;
+            }
+            if (info.dli_fname) {
+                file = info.dli_fname;
+            }
+        }
+        int n = g_snprintf(line, sizeof(line), "#%02d %p %s+0x%tx (%s)\n",
+                           i, frames[i], sym,
+                           reinterpret_cast<char *>(frames[i]) - reinterpret_cast<char *>(base),
+                           file);
+        if (n > 0) {
+            write(fd, line, n);
+        }
+    }
+}
+#endif
